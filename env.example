# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Self-hosted Bot API credentials (get from https://my.telegram.org/apps)
TELEGRAM_API_ID=your_api_id_here
TELEGRAM_API_HASH=your_api_hash_here

# Self-hosted Bot API configuration
USE_SELF_HOSTED_API=true
SELF_HOSTED_API_URL=http://telegram-bot-api:8081
MAX_FILE_SIZE_MB=2000

# Yandex Disk (optional)
YANDEX_DISK_TOKEN=your_yandex_token_here
YANDEX_DISK_FOLDER=unique_video_factory

# Apify (Instagram Reels scraper)
APIFY_TOKEN=your_apify_api_token_here
APIFY_IG_USERNAME=your_instagram_username
APIFY_IG_PASSWORD=your_instagram_password_optional
APIFY_IG_SESSIONID=your_instagram_sessionid_cookie_optional
APIFY_TT_SESSIONID=your_tiktok_sessionid_cookie_optional

# Video processing
MAX_VIDEO_SIZE_MB=300
